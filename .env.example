# Copy this file to .env and fill in the values. .env is never committed.

# Shared secret services use to talk to each other (any long random string).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# Timezone used to show times and to decide what "today" and "overdue" mean.
TZ=Europe/Riga

# Telegram bot token from @BotFather (for the bot service).
TELEGRAM_TOKEN=

# When the bot sends each person their tickets due today or late (home time, HH:MM).
MORNING_SUMMARY_TIME=08:30
